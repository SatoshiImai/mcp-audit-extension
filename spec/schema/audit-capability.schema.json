{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "L1",
        "L2"
      ]
    },
    "attempt": {
      "type": "string",
      "const": "request"
    },
    "attempt_ack_deadline_ms": {
      "default": 500,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "block_disposition": {
      "default": [
        "abort"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "abort",
          "partial"
        ]
      }
    },
    "outcome_mode": {
      "default": "batched",
      "type": "string",
      "enum": [
        "batched",
        "request"
      ]
    },
    "outcome_batch_window_ms": {
      "default": 200,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "level",
    "attempt",
    "attempt_ack_deadline_ms",
    "block_disposition",
    "outcome_mode",
    "outcome_batch_window_ms"
  ],
  "additionalProperties": false
}
