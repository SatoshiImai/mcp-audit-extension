{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "accept"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "record_hash": {
          "type": "string"
        },
        "host_ts": {
          "type": "string"
        },
        "previous_hash": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "seq",
        "record_hash",
        "host_ts",
        "previous_hash"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "reject"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unavailable"
        },
        "reason": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "status",
        "reason",
        "retryable"
      ],
      "additionalProperties": false
    }
  ]
}
